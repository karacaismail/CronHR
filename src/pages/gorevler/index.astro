---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AiBrief from "../../components/AiBrief.astro";
import Kpi from "../../components/Kpi.astro";
import Panel from "../../components/Panel.astro";
import Badge from "../../components/Badge.astro";
import AiHint from "../../islands/AiHint";
import { TASKS } from "../../data/hr2";
import { At, Check, Checks, Sparkle, Warning, WarningCircle } from "@phosphor-icons/react";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const groups = [
  { key: "Onay", label: "Onaylar" },
  { key: "Talep", label: "Talepler" },
  { key: "Görev", label: "Görevler" },
  { key: "Hata", label: "Hatalar" },
  { key: "Uyarı", label: "Uyarılar" },
  { key: "Bahsetme", label: "Bahsetmeler" },
] as const;
const kindTone = { Onay: "info", Talep: "info", Görev: "neutral", Hata: "critical", Uyarı: "warning", Bahsetme: "ai" } as const;
---

<AdminLayout pageId="gorevler" description="Onaylar, talepler, görevler, hatalar ve bahsetmeler tek gelen kutusunda. AI her satıra görüş ekler ve hazır olanları tek seferde onaylamayı önerir.">
  <Fragment slot="actions">
    <button type="button" class="btn btn-ai" data-ask-ai="Hazır olan onayları tek seferde onayla"><Sparkle size={14} weight="fill" /> Hazır olanları onayla</button>
    <button type="button" class="btn"><Checks size={14} /> Tümünü okundu işaretle</button>
  </Fragment>

  <AiBrief
    lead="<strong>11 açık iş</strong>: 5 onay, 1 talep, 2 görev, 1 hata, 1 uyarı, 1 bahsetme. 4 onay politika içinde ve çakışmasız; tek seferde onaylanabilir. 2 kalem gecikmiş."
    points={[
      { tone: "critical", text: "<strong>Slack izin senkronu</strong> 2 gündür hatalı; 3 talep dışarıda kalmış olabilir." },
      { tone: "warning", text: "<strong>Emre Doğan</strong> fazla mesai onayı aylık sınıra 2 saat bırakıyor; vardiya devri ile birlikte değerlendirin." },
      { tone: "info", text: "Puantaj onayı 25 Eylül'e kadar tamamlanmazsa bordro Draft'ta kalır." },
    ]}
    chips={["Bekleyen onayları özetle", "Bugün süresi dolan görevleri listele", "Görevleri önceliğe göre sırala"]}
  />

  <div class="grid grid-4">
    <Kpi label="Açık iş" value="11" delta="2 gecikmiş" dir="down" />
    <Kpi label="Onaya hazır" value="4" delta="AI görüşü" dir="up" ai="Tek tıkla toplu onay" />
    <Kpi label="Bugün son gün" value="2" delta="izin + mesai" dir="flat" />
    <Kpi label="Ortalama yanıt" value="1,4 gün" delta="hedef 1 gün" dir="down" />
  </div>

  {groups.map((g) => {
    const items = TASKS.filter((t) => t.kind === g.key);
    if (!items.length) return null;
    return (
      <Panel title={g.label} sub={`${items.length} kayıt`} flush>
        <ul>
          {items.map((t) => (
            <li class="list-item">
              <span class="list-icon" data-tone={t.tone === "neutral" ? undefined : t.tone === "serious" ? "warning" : t.tone}>
                {t.kind === "Hata" ? <WarningCircle size={16} /> : t.kind === "Uyarı" ? <Warning size={16} /> : t.kind === "Bahsetme" ? <At size={16} /> : <Check size={16} />}
              </span>
              <a class="list-main" href={`${base}${t.page}`}>
                <div class="row" style="gap:8px;flex-wrap:wrap"><span class="list-title">{t.title}</span><Badge tone={kindTone[t.kind]} plain>{t.kind}</Badge></div>
                <div class="list-sub">Son tarih: {t.due} · AI: {t.aiVerdict}</div>
              </a>
              <AiHint client:visible title="AI görüşü" answer={`${t.aiVerdict}. ${t.kind === "Onay" ? "Politika ve takvim kontrolü yapıldı; karar sizde." : t.kind === "Hata" ? "Düzeltme adımı tek tık; sonrasında bekleyen kayıtlar otomatik işlenir." : "Sayfaya giderek ayrıntıyı görebilirsiniz."}`} actions={t.kind === "Onay" ? ["Onayla", "Reddet"] : t.kind === "Hata" ? ["Düzelt"] : ["Sayfaya git"]} mode="popover" />
              {t.kind === "Onay" ? (
                <span class="row" style="gap:4px">
                  <button type="button" class="icon-btn" aria-label="Onayla" style="color:var(--good)"><Check size={14} weight="bold" /></button>
                </span>
              ) : null}
            </li>
          ))}
        </ul>
      </Panel>
    );
  })}
</AdminLayout>
