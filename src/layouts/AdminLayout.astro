---
import "../styles/global.css";
import "../styles/themes.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Sidebar from "../components/Sidebar.astro";
import SubNav from "../components/SubNav.astro";
import CommandBar from "../islands/CommandBar";
import Copilot from "../islands/Copilot";
import { resolvePage } from "../data/nav";
import { Buildings, CaretUpDown, List, Plus, Question, SquaresFour, Sparkle, Tray, Users } from "@phosphor-icons/react";

interface Props {
  pageId: string;
  title?: string;
  description?: string;
  eyebrow?: string;
  section?: string;
  /** Grup sekmelerini gizle (ör. detay sayfaları). */
  hideSubNav?: boolean;
}

const { pageId, title, description, eyebrow, section, hideSubNav = false } = Astro.props;
const page = resolvePage(pageId);
const base = import.meta.env.BASE_URL;
const docTitle = `${title ?? page.label} · CronHR`;
const eyebrowText = eyebrow ?? (page.leaf ? page.group.label : page.group.label);
---

<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description ?? page.description} />
    <meta name="theme-color" content="#eceef3" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{docTitle}</title>
    <script is:inline>
      // Tema, boyamadan önce köke yazılır (flaş yok). Saklanan seçim yoksa
      // sistem tercihi: prefers-contrast → a11y, prefers-color-scheme → dark.
      (function () {
        try {
          var t = localStorage.getItem("cronhr-theme");
          if (t !== "light" && t !== "dark" && t !== "a11y") {
            t = matchMedia("(prefers-contrast: more)").matches ? "a11y" : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.dataset.theme = t;
        } catch (e) { document.documentElement.dataset.theme = "light"; }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#icerik">İçeriğe atla</a>
    <div class="app">
      <Sidebar currentId={pageId} />
      <div class="drawer-backdrop" data-drawer-close aria-hidden="true"></div>
      <div class="main">
        <header class="topbar" aria-label="Üst çubuk">
          <div class="topbar-side topbar-left">
            <button type="button" class="icon-btn menu-btn" data-drawer-toggle aria-label="Menüyü aç" aria-controls="kenar-cubugu" aria-expanded="false"><List size={18} /></button>
            <button type="button" class="context-switch" title="Tenant / şirket değiştir">
              <Buildings size={15} />
              <span class="context-text"><span class="context-tenant">Karaca Holding</span><span class="context-company">Karaca Teknoloji A.Ş.</span></span>
              <CaretUpDown size={13} color="var(--ink-faint)" />
            </button>
          </div>
          <CommandBar client:load currentPageId={pageId} section={section} base={base} />
          <div class="topbar-side topbar-right">
            <button type="button" class="icon-btn copilot-desktop-btn" title="CronHR Copilot" aria-label="CronHR Copilot'u aç" onclick="window.dispatchEvent(new CustomEvent('cronhr:copilot'))"><Sparkle size={15} weight="fill" /></button>
            <button type="button" class="btn btn-primary btn-sm" title="Yeni kayıt oluştur"><Plus size={13} weight="bold" /> Oluştur</button>
            <ThemeSwitcher />
            <a class="icon-btn" href={`${base}mimari/`} title="Yardım ve mimari" aria-label="Yardım ve mimari"><Question size={15} /></a>
          </div>
        </header>
        <main class="content" id="icerik" tabindex="-1">
          <header class="page-head">
            <div>
              <p class="page-eyebrow">{eyebrowText}</p>
              <h1 class="page-title">{title ?? page.label}</h1>
              {(description ?? page.description) ? <p class="page-desc">{description ?? page.description}</p> : null}
            </div>
            <div class="page-actions">
              <slot name="actions" />
            </div>
          </header>
          {!hideSubNav && page.group.children ? <SubNav group={page.group} currentLeafId={page.leaf?.id} /> : null}
          <slot />
        </main>
        <nav class="bottom-nav" aria-label="Hızlı gezinme">
          <a href={`${base}`} aria-current={pageId === "panel" ? "page" : undefined}><SquaresFour size={20} /><span>Panel</span></a>
          <a href={`${base}gorevler/`} aria-current={pageId === "gorevler" ? "page" : undefined}><Tray size={20} /><span>Görevler</span></a>
          <button type="button" class="bn-ai" aria-label="Copilot'u aç" onclick="window.dispatchEvent(new CustomEvent('cronhr:copilot'))"><span><Sparkle size={20} weight="fill" /></span><span>AI</span></button>
          <a href={`${base}calisanlar/`} aria-current={pageId === "calisanlar" ? "page" : undefined}><Users size={20} /><span>İnsanlar</span></a>
          <button type="button" data-drawer-toggle aria-label="Menü"><List size={20} /><span>Menü</span></button>
        </nav>
        <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
        <Copilot client:load pageId={pageId} base={base} />
      </div>
    </div>
    <script>
      import "../scripts/motion";
    </script>
    <script>
      // Çekmece menü (mobil): aç/kapat, Escape, arka plan tıklaması, odak yönetimi.
      const root = document.documentElement;
      const setDrawer = (open: boolean) => {
        root.dataset.drawer = open ? "open" : "closed";
        for (const b of document.querySelectorAll<HTMLElement>("[data-drawer-toggle]")) b.setAttribute("aria-expanded", String(open));
        if (open) document.querySelector<HTMLElement>(".sidebar a, .sidebar button")?.focus();
      };
      document.addEventListener("click", (event) => {
        const el = event.target as HTMLElement;
        if (el.closest("[data-drawer-toggle]")) setDrawer(root.dataset.drawer !== "open");
        else if (el.closest("[data-drawer-close]")) setDrawer(false);
        else if (el.closest(".sidebar a") && root.dataset.drawer === "open") setDrawer(false);
      });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape" && root.dataset.drawer === "open") setDrawer(false); });
      // Dışa aktarma: demo bildirimi (toast).
      const toast = document.querySelector<HTMLElement>("[data-toast]");
      let toastTimer = 0;
      window.addEventListener("cronhr:export", (event) => {
        const d = (event as CustomEvent<{ title?: string; rows: unknown[] }>).detail;
        if (!toast) return;
        toast.textContent = `${d.rows.length} kayıt dışa aktarıldı (demo): ${d.title ?? "tablo"}.csv`;
        toast.hidden = false;
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => { toast.hidden = true; }, 3200);
      });
      // Tema değiştirici: aria-pressed senkronu + localStorage + olay.
      const applyThemeButtons = () => {
        const t = document.documentElement.dataset.theme ?? "light";
        for (const b of document.querySelectorAll<HTMLButtonElement>("[data-set-theme]")) b.setAttribute("aria-pressed", String(b.dataset.setTheme === t));
      };
      applyThemeButtons();
      document.addEventListener("click", (event) => {
        const b = (event.target as HTMLElement).closest<HTMLElement>("[data-set-theme]");
        if (!b) return;
        const t = b.dataset.setTheme ?? "light";
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem("cronhr-theme", t); } catch {}
        applyThemeButtons();
        window.dispatchEvent(new CustomEvent("cronhr:theme", { detail: { theme: t } }));
      });
      // Kaydırılabilir tablolar odaklanabilir olsun (WCAG 2.1.1 / axe scrollable-region-focusable).
      for (const el of document.querySelectorAll<HTMLElement>(".table-wrap, .kanban, .shift-grid")) {
        if (el.scrollWidth > el.clientWidth && !el.querySelector("a[href], button, input, select, textarea, [tabindex]")) {
          el.tabIndex = 0;
          el.setAttribute("role", "region");
          el.setAttribute("aria-label", "Yatay kaydırılabilir tablo");
        }
      }
      // Sayfa içi "AI'ya sor" düğmeleri: komuta kartını açar.
      document.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>("[data-ask-ai]");
        if (!target) return;
        window.dispatchEvent(new CustomEvent("cronhr:ask", { detail: { query: target.dataset.askAi } }));
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
      // Statik anahtar/segment düğmeleri: yalnızca görsel durum (frontend demo).
      document.addEventListener("click", (event) => {
        const el = event.target as HTMLElement;
        const sw = el.closest<HTMLElement>(".switch");
        if (sw) sw.setAttribute("aria-checked", sw.getAttribute("aria-checked") === "true" ? "false" : "true");
        const seg = el.closest<HTMLElement>(".segment > button");
        if (seg && seg.parentElement) {
          for (const b of seg.parentElement.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b === seg));
        }
      });
    </script>
  </body>
</html>
