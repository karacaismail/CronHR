---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AiBrief from "../../components/AiBrief.astro";
import Kpi from "../../components/Kpi.astro";
import Panel from "../../components/Panel.astro";
import Bars from "../../components/Bars.astro";
import AiHint from "../../islands/AiHint";
import { GEN } from "../../data/generate";
import DataTable from "../../islands/DataTable";
import { Sparkle } from "@phosphor-icons/react";

---

<AdminLayout pageId="fazla-mesai" description="Fazla mesai talepleri, onayları ve aylık sınır takibi. Onaylanan mesai puantaja, oradan bordroya akar; sınır aşımı engine tarafından engellenir.">
  <Fragment slot="actions">
    <button type="button" class="btn btn-ai" data-ask-ai="Fazla mesai sınırına yaklaşanları göster"><Sparkle size={14} weight="fill" /> Sınır analizi</button>
    <button type="button" class="btn btn-primary">Talep oluştur</button>
  </Fragment>

  <AiBrief
    lead="Bu ay <strong>214 saat</strong> fazla mesai, geçen aya göre +%18. Mühendislik nöbetleri toplamın %61'i. <strong>Emre Doğan</strong> 62 saatle politika sınırına 10 saat kaldı; bekleyen 8 saatlik talep onaylanırsa 2 saat kalır."
    points={[
      { tone: "critical", text: "Sınıra 2 saat kalan onay: sistem 72 saati aşan talebi otomatik reddeder; şimdi devretmek daha ucuz." },
      { tone: "info", text: "Yasal aylık üst sınır 270 saat/yıl; şirket politikası aylık 72 saat ve ardışık 3 gece." },
      { tone: "good", text: "Fazla mesai maliyeti puantaj kilitlendikten sonra bordroya %50 zamlı saat olarak akar." },
    ]}
    chips={["Fazla mesai maliyetini departmana göre kır", "Gece vardiyası dağılımını dengele", "Bu sayfayı açıkla"]}
  />

  <div class="grid grid-4">
    <Kpi label="Bu ay toplam" value="214 sa" delta="+%18" dir="down" />
    <Kpi label="Onay bekleyen" value={String(GEN.overtime.filter((o) => o.state === "Onay bekliyor").length)} delta={`${GEN.overtime.filter((o) => o.state === "Onay bekliyor").reduce((s, o) => s + o.hours, 0)} saat`} dir="flat" />
    <Kpi label="Sınıra yakın" value="1" delta="Emre Doğan" dir="down" ai="Pazar nöbetini devret" />
    <Kpi label="Maliyet (tahmini)" value="214.300 ₺" delta="bordroya akar" dir="flat" />
  </div>

  <div class="grid grid-main">
    <Panel title="Talepler" sub="Onaylanan mesai puantaja yazılır · sınır takibi" flush>
      <div class="panel-body"><DataTable client:load preset="overtime" title="Fazla mesai" rows={GEN.overtime} pageSize={10} /></div>
    </Panel>
    <Panel title="Departman dağılımı" sub="Bu ay · saat">
      <Bars items={[{ label: "Mühendislik", value: 131, tone: "critical" }, { label: "Destek", value: 42 }, { label: "Satış", value: 22 }, { label: "Ürün", value: 11 }, { label: "Diğer", value: 8 }]} unit=" sa" />
    </Panel>
  </div>
</AdminLayout>
