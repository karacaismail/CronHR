---
import { CaretDown, Timer } from "@phosphor-icons/react";
import { NAV_TREE, resolvePage } from "../data/nav";
import { TAGLINES } from "../data/taglines";
import ThemeSwitcher from "./ThemeSwitcher.astro";

interface Props {
  currentId: string;
}

const { currentId } = Astro.props;
const current = resolvePage(currentId);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<aside class="sidebar" id="kenar-cubugu" aria-label="Kenar çubuğu">
  <a class="brand" href={`${base}/`}>
    <span class="brand-mark"><Timer size={19} weight="fill" /></span>
    <span>
      <span class="brand-name">CronHR</span>
      <span class="brand-tag" id="marka-motto">{TAGLINES[0]}</span>
    </span>
  </a>

  <nav class="nav" aria-label="Ana menü">
    {NAV_TREE.map((group) => {
      const Icon = group.icon;
      const isActiveGroup = current.group.id === group.id;
      if (!group.children) {
        return (
          <a class="nav-item" href={`${base}${group.href}`} aria-current={isActiveGroup ? "page" : undefined}>
            <Icon size={17} />
            <span>{group.label}</span>
            {group.badge ? <span class="nav-badge" data-tone={group.badgeTone}>{group.badge}</span> : null}
          </a>
        );
      }
      return (
        <details class="nav-group" open={isActiveGroup}>
          <summary class="nav-item nav-summary" data-active={isActiveGroup}>
            <Icon size={17} />
            <span>{group.label}</span>
            {group.badge ? <span class="nav-badge" data-tone={group.badgeTone}>{group.badge}</span> : null}
            <span class="nav-caret"><CaretDown size={12} /></span>
          </summary>
          <div class="nav-children">
            {group.children.map((leaf) => (
              <a class="nav-item nav-leaf" href={`${base}${leaf.href}`} aria-current={current.leaf?.id === leaf.id ? "page" : undefined}>
                <span>{leaf.label}</span>
                {leaf.badge ? <span class="nav-badge" data-tone={leaf.badgeTone}>{leaf.badge}</span> : null}
              </a>
            ))}
          </div>
        </details>
      );
    })}
  </nav>

  <div class="sidebar-foot">
    <div class="row-between"><span class="small strong">Görünüm</span><ThemeSwitcher /></div>
    <div class="ai-status"><span class="ai-dot" aria-hidden="true"></span> AI asistan çevrimiçi</div>
    <p class="ai-status-meta">Karaca Teknoloji · 120 çalışan · 2 tüzel kişilik. Öneriler onaysız uygulanmaz.</p>
  </div>
</aside>

<script>
  import { TAGLINES } from "../data/taglines";
  import { readMotionContext, shouldAnimate } from "../scripts/motion-core";
  import { startTagline, type TaglineController } from "../scripts/tagline";

  let controller: TaglineController | null = null;

  function sync() {
    const el = document.getElementById("marka-motto");
    if (!el) return;
    const ok = shouldAnimate(readMotionContext());
    if (ok && !controller) {
      controller = startTagline(el, TAGLINES);
    } else if (!ok && controller) {
      controller.stop();
      controller = null;
    }
  }

  sync();
  window.addEventListener("cronhr:theme", sync);
</script>
