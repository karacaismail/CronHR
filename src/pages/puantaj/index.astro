---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AiBrief from "../../components/AiBrief.astro";
import Kpi from "../../components/Kpi.astro";
import Panel from "../../components/Panel.astro";
import Pipeline from "../../components/Pipeline.astro";
import AiHint from "../../islands/AiHint";
import { GEN } from "../../data/generate";
import DataTable from "../../islands/DataTable";
import { Calculator, LockKey, Sparkle } from "@phosphor-icons/react";

const totals = GEN.timesheet.reduce((a, r) => ({ normal: a.normal + r.normalHours, ot: a.ot + r.overtime, night: a.night + r.night }), { normal: 0, ot: 0, night: 0 });
---

<AdminLayout pageId="puantaj" description="Time Calculation Engine: vardiya (plan) + PDKS (gerçek) + izin (haklı yokluk) + fazla mesai/düzeltme › hesaplanmış çalışma ve payroll units. Bordro ham hareketi değil, bunu okur.">
  <Fragment slot="actions">
    <button type="button" class="btn"><Calculator size={14} /> Yeniden hesapla</button>
    <button type="button" class="btn btn-ai" data-ask-ai="Bu ayın puantajını bordroya hazırla"><Sparkle size={14} weight="fill" /> Bordroya hazırla</button>
    <button type="button" class="btn btn-primary"><LockKey size={14} /> Onayla ve kilitle</button>
  </Fragment>

  <AiBrief
    lead="Eylül puantajı <strong>120 çalışan</strong> için hesaplandı: 3 kilitli, 4 onaylı, 4 onay bekliyor, 1 açık istisna. Bordro 25 Eylül'de Draft'tan çıkamaz; önce bekleyen onaylar tamamlanmalı."
    points={[
      { tone: "critical", text: "<strong>Emre Doğan</strong> 62 saat fazla mesai; politika sınırı 72. Pazar nöbeti devredilirse 54'e iner." },
      { tone: "warning", text: "<strong>Mert Kaya</strong>'nın 3 mazeret günü ücretsiz işlenmiş; politika ücretli diyor. Düzeltme bordroya +2.150 ₺ ekler." },
      { tone: "info", text: "<strong>Ayşe Aydın</strong>'ın eksik IN düzeltme talebi onaylanınca devamsızlık 1 › 0 olur ve satır otomatik yeniden hesaplanır." },
    ]}
    chips={["Fazla mesai sınırına yaklaşanları göster", "Onay bekleyen puantajları listele", "Bu sayfayı açıkla"]}
  />

  <Panel title="İşgücü zinciri" sub="Puantaj hesaplar; bordro yalnızca bu çıktıyı paraya çevirir">
    <Pipeline active="puantaj" compact />
  </Panel>

  <div class="grid grid-4">
    <Kpi label="Normal saat" value={new Intl.NumberFormat("tr-TR").format(totals.normal)} delta="120 çalışan" dir="flat" />
    <Kpi label="Fazla mesai" value={`${totals.ot} sa`} delta="1 sınıra yakın" dir="down" ai="%86'sı Emre Doğan" />
    <Kpi label="Gece saati" value={`${totals.night} sa`} delta="gece primi" dir="flat" />
    <Kpi label="Onay durumu" value={`${GEN.timesheet.filter((t) => t.state === "Onaylandı" || t.state === "Kilitli").length} / ${GEN.timesheet.length}`} delta="onaylı + kilitli" dir="up" />
  </div>

  <Panel title="Eylül 2026 puantajı" sub="Payroll units: gün, saat, izin, mesai, gece, devamsızlık · 120 çalışan" flush>
    <div class="panel-body"><DataTable client:load preset="timesheet" title="Puantaj" rows={GEN.timesheet} pageSize={10} /></div>
    <Fragment slot="foot"><span class="state-flow"><span data-state="done">Hesaplandı</span><i></i><span data-state="current">Onay</span><i></i><span>Kilit</span><i></i><span>Bordroya aktarım</span></span></Fragment>
  </Panel>
</AdminLayout>
