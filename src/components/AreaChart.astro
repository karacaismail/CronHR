---
/**
 * Statik SVG alan/çizgi grafiği. Dataviz kuralları: ince işaret, çekingen
 * ızgara, doğrudan son değer etiketi, seri başına lejant.
 */
interface Series {
  name: string;
  values: number[];
  color?: string;
}

interface Props {
  labels: string[];
  series: Series[];
  unit?: string;
  height?: number;
  area?: boolean;
}

const { labels, series, unit = "", height = 200, area = true } = Astro.props;
const palette = ["var(--series-1)", "var(--series-2)", "var(--series-3)", "var(--series-4)"];
const width = 640;
const pad = { top: 16, right: 54, bottom: 26, left: 10 };
const plotW = width - pad.left - pad.right;
const plotH = height - pad.top - pad.bottom;
const all = series.flatMap((s) => s.values);
const max = Math.max(...all) * 1.1;
const min = Math.min(0, ...all);
const x = (i: number) => pad.left + (plotW * i) / (labels.length - 1);
const y = (v: number) => pad.top + plotH - ((v - min) / (max - min)) * plotH;
const ticks = [0, 0.5, 1].map((t) => min + (max - min) * t);
const paths = series.map((s, si) => {
  const line = s.values.map((v, i) => `${i === 0 ? "M" : "L"} ${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(" ");
  const fill = `${line} L ${x(s.values.length - 1).toFixed(1)} ${y(min).toFixed(1)} L ${x(0).toFixed(1)} ${y(min).toFixed(1)} Z`;
  return { ...s, color: s.color ?? palette[si % palette.length], line, fill, last: s.values[s.values.length - 1] };
});
const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(1).replace(".", ","));
---

<figure class="chart">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={series.map((s) => s.name).join(", ")} style="inline-size:100%;block-size:auto">
    {ticks.map((t) => (
      <g>
        <line x1={pad.left} x2={width - pad.right} y1={y(t)} y2={y(t)} stroke="var(--border)" stroke-dasharray={t === min ? undefined : "2 4"} />
        <text x={width - pad.right + 6} y={y(t) + 3.5} font-size="10" fill="var(--ink-faint)">{fmt(t)}{unit}</text>
      </g>
    ))}
    {paths.map((p) => (
      <g>
        {area ? <path d={p.fill} fill={p.color} opacity="0.08" /> : null}
        <path d={p.line} fill="none" stroke={p.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx={x(p.values.length - 1)} cy={y(p.last)} r="3.2" fill={p.color} />
        <text x={x(p.values.length - 1) + 7} y={y(p.last) + 3.5} font-size="10.5" font-weight="700" fill={p.color}>{fmt(p.last)}{unit}</text>
      </g>
    ))}
    {labels.map((l, i) => (
      i % Math.ceil(labels.length / 8) === 0 || i === labels.length - 1 ? (
        <text x={x(i)} y={height - 8} font-size="10" text-anchor="middle" fill="var(--ink-faint)">{l}</text>
      ) : null
    ))}
  </svg>
  <figcaption class="chart-legend">
    {paths.map((p) => (
      <span class="chart-legend-item"><span class="chart-swatch" style={`background:${p.color}`}></span>{p.name}</span>
    ))}
  </figcaption>
</figure>

<style>
  .chart { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .chart-legend { display: flex; flex-wrap: wrap; gap: 12px; font-size: 11.5px; color: var(--ink-muted); }
  .chart-legend-item { display: inline-flex; align-items: center; gap: 6px; }
  .chart-swatch { inline-size: 10px; block-size: 10px; border-radius: 3px; }
</style>
