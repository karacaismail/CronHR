---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AiBrief from "../../components/AiBrief.astro";
import Kpi from "../../components/Kpi.astro";
import Panel from "../../components/Panel.astro";
import Badge from "../../components/Badge.astro";
import Avatar from "../../components/Avatar.astro";
import Bars from "../../components/Bars.astro";
import AiHint from "../../islands/AiHint";
import { GEN } from "../../data/generate";
import DataTable from "../../islands/DataTable";
import QuickCreate from "../../islands/QuickCreate";
import { DEPARTMENTS, EMPLOYEES, formatDate, riskLabel, riskTone } from "../../data/hr";
import { Export, Plus, Sparkle } from "@phosphor-icons/react";

const statusTone = { Aktif: "good", Deneme: "info", "İzinli": "neutral", "Ayrılıyor": "critical" } as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const remote = EMPLOYEES.filter((e) => e.location === "Uzaktan").length;
---

<AdminLayout pageId="calisanlar" description="120 çalışan, 7 departman. Her satırda AI risk skoru ve tek tıkla açıklama.">
  <Fragment slot="actions">
    <button type="button" class="btn"><Export size={14} /> Dışa aktar</button>
    <button type="button" class="btn btn-primary"><Plus size={14} weight="bold" /> Yeni çalışan</button>
  </Fragment>

  <AiBrief
    lead="Kadro <strong>sağlıklı</strong>: 12 ayda %22 büyüme, gönüllü ayrılma %9,6 (sektör %13). İki kişi izleme eşiğinin üstünde; ortak sinyal ünvan durağanlığı ve ücret bandı."
    points={[
      { tone: "critical", text: "<strong>Ahmet Yıldız</strong> (78) ve <strong>Selin Çelik</strong> (64) için bu hafta görüşme önerilir." },
      { tone: "warning", text: "<strong>Mert Kaya</strong>'nın deneme süresi 16 Eylül'de bitiyor; ilk değerlendirme formu boş." },
      { tone: "good", text: "Burak Şahin terfi sonrası katılımı 88'e çıkardı; mentor adayı." },
    ]}
    chips={["Ayrılma riski yüksek çalışanları listele", "Deneme süresi bu ay biten kişiler kim?", "Departman bazında kadro dağılımını göster"]}
  />

  <div class="grid grid-4">
    <Kpi label="Aktif çalışan" value={String(GEN.employees.filter((e) => e.status !== "Ayrılıyor").length)} delta="+2" dir="up" ai="Ekim'de 3 başlangıç planlı." />
    <Kpi label="Uzaktan oranı" value={`%${Math.round((remote / EMPLOYEES.length) * 100)}`} delta="hedef %35" dir="flat" ai="Politika sınırı içinde." />
    <Kpi label="Ortalama kıdem" value="3,4 yıl" delta="+0,3" dir="up" />
    <Kpi label="Gönüllü ayrılma" value="%9,6" delta="sektör %13" dir="up" ai="Mühendislik'te %12; izleme listesi orada." />
  </div>

  <div class="grid grid-main">
    <Panel title="Çalışanlar" sub="AI risk skoru, filtre, sıralama ve doğal dil sorgusu" flush>
      <Fragment slot="tools">
        <button type="button" class="btn btn-ai btn-sm" data-ask-ai="Ayrılma riski yüksek çalışanları listele"><Sparkle size={12} weight="fill" /> Riskli olanlar</button>
      </Fragment>
      <div class="panel-body"><DataTable client:load preset="employees" title="Çalışanlar" rows={GEN.employees} pageSize={10} selectable /></div>
      <Fragment slot="foot">{GEN.employees.length} çalışan · Satıra tıklayın: Employee 360 · AI skorları her gece yeniden hesaplanır</Fragment>
    </Panel>

    <div class="stack" style="gap:16px">
      <Panel title="Departman dağılımı" sub="Kadro ve açık pozisyon">
        <Bars items={DEPARTMENTS.map((d) => ({ label: d.name, value: d.headcount, tone: d.open > 0 ? "accent" : "info", hint: `${d.open} açık pozisyon` }))} unit=" kişi" />
      </Panel>
      <Panel title="AI ile hızlı kayıt" sub="Serbest metinden çalışan profili oluştur">
<QuickCreate client:load />
      </Panel>
    </div>
  </div>
</AdminLayout>
