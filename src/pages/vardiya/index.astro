---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AiBrief from "../../components/AiBrief.astro";
import Kpi from "../../components/Kpi.astro";
import Panel from "../../components/Panel.astro";
import Bars from "../../components/Bars.astro";
import ShiftPlanner from "../../islands/ShiftPlanner";
import { Sparkle } from "@phosphor-icons/react";
---

<AdminLayout pageId="vardiya" description="Gün, hafta, ay, çeyrek, 6 ay, yıl ya da özel tarih aralığında planlayın. Boş vardiyaları AI önerir, çakışmaları anında işaretler; yayınlamadan önce siz onaylarsınız.">
  <Fragment slot="actions">
    <button type="button" class="btn btn-ai" data-ask-ai="Bu haftaki boş vardiyaları doldur"><Sparkle size={14} weight="fill" /> AI ile doldur</button>
    <button type="button" class="btn btn-primary">Planı yayınla</button>
  </Fragment>

  <AiBrief
    lead="Planda <strong>2 boşluk</strong> ve <strong>1 çakışma</strong> var. AI iki boşluk için öneri üretti; Emre Doğan'ın pazar gecesi nöbeti aylık fazla mesai sınırını aşıyor."
    points={[
      { tone: "critical", text: "<strong>Emre Doğan</strong> · Paz 13 gece: bu ay 62 saat fazla mesai; yasal sınıra 28 saat kaldı. Öneri: Burak Şahin'e devret." },
      { tone: "info", text: "Per 10 sabah ve Cmt 12 gündüz boş; AI, izin bakiyesi ve önceki tercihlerine göre Mert Kaya ve Ayşe Aydın'ı öneriyor." },
      { tone: "good", text: "Can Öztürk 12 Eylül'de izinden dönüyor; gelecek hafta Destek gece dengesi normale döner." },
    ]}
    chips={["Çakışan vardiyaları bul", "Gece vardiyası dağılımını dengele", "Gelecek haftanın planını taslak olarak oluştur"]}
  />

  <div class="grid grid-4">
    <Kpi label="Kapsama" value="17 / 20" delta="Per 10 · 08–16" dir="down" ai="Gerekli 20, atanmış 17, eksik 3" />
    <Kpi label="Boş vardiya" value="2" delta="AI önerdi" dir="up" />
    <Kpi label="Çakışma" value="1" delta="fazla mesai" dir="down" ai="Emre Doğan · Paz 13 gece" />
    <Kpi label="Gece yükü dengesi" value="%71" delta="+9 puan" dir="up" ai="En yüksek yük Emre'de (6/7 gece)." />
  </div>

  <Panel title="Plan" sub="Görünüm modunu seçin; hücreye tıklayıp AI önerisini uygulayın" flush>
    <ShiftPlanner client:load />
    <Fragment slot="foot">
      <span class="state-flow" style="margin-inline-end:12px"><span data-state="current">Draft</span><i></i><span>Published</span><i></i><span>Locked</span></span>
      <span class="shift" data-kind="morning" style="inline-size:auto">Sabah</span>
      <span class="shift" data-kind="day" style="inline-size:auto">Gündüz</span>
      <span class="shift" data-kind="night" style="inline-size:auto">Gece</span>
      <span class="shift" data-kind="leave" style="inline-size:auto">İzin</span>
      <span class="shift" data-kind="ai" style="inline-size:auto">AI önerisi</span>
      <span class="shift" data-kind="conflict" style="inline-size:auto">Çakışma</span>
    </Fragment>
  </Panel>

  <div class="grid grid-2">
    <Panel title="Gece vardiyası dağılımı" sub="Bu ay · kişi başına gece sayısı">
      <Bars items={[{ label: "Emre Doğan", value: 14, tone: "critical" }, { label: "Can Öztürk", value: 8 }, { label: "Selin Çelik", value: 6 }, { label: "Burak Şahin", value: 3 }, { label: "Ayşe Aydın", value: 2 }]} unit=" gece" />
    </Panel>
    <Panel title="AI kuralları" sub="Plan üretirken uygulanan kısıtlar">
      <ul class="stack" style="gap:8px">
        <li class="row-between"><span>İki vardiya arası en az 11 saat dinlenme</span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="Dinlenme kuralı"></button></li>
        <li class="row-between"><span>Ardışık gece vardiyası en fazla 3</span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="Gece kuralı"></button></li>
        <li class="row-between"><span>Aylık fazla mesai üst sınırı 72 saat</span><button type="button" class="switch" role="switch" aria-checked="true" aria-label="Mesai kuralı"></button></li>
        <li class="row-between"><span>Çalışan tercihlerini önceliklendir</span><button type="button" class="switch" role="switch" aria-checked="false" aria-label="Tercih kuralı"></button></li>
      </ul>
    </Panel>
  </div>
</AdminLayout>
