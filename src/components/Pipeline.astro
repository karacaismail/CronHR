---
/**
 * İşgücü zinciri: Vardiya planlar › PDKS ölçer › İzin açıklar › Puantaj
 * hesaplar › Bordro paraya çevirir › Muhasebe/SGK/GİB. Her sayfada aktif
 * halka vurgulanır; halkalar ilgili sayfaya bağlanır.
 */
interface Props {
  active?: string;
  compact?: boolean;
}

const { active, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const STEPS = [
  { id: "organizasyon", label: "Organizasyon + Özlük", verb: "tanımlar", href: "/organizasyon/" },
  { id: "vardiya", label: "Takvim / Vardiya", verb: "planlar", href: "/vardiya/" },
  { id: "pdks", label: "PDKS", verb: "ölçer", href: "/pdks/" },
  { id: "izinler", label: "İzin", verb: "açıklar", href: "/izin-devam/" },
  { id: "puantaj", label: "Puantaj", verb: "hesaplar", href: "/puantaj/" },
  { id: "bordrolar", label: "Bordro", verb: "paraya çevirir", href: "/bordro/" },
  { id: "odemeler", label: "Muhasebe / SGK / GİB", verb: "bildirir", href: "/odemeler/" },
];
---

<ol class:list={["pipeline", { compact }]} aria-label="İşgücü zinciri">
  {STEPS.map((s, i) => (
    <li class="pipe-step" data-active={s.id === active}>
      <a href={`${base}${s.href}`} class="pipe-link">
        <span class="pipe-index">{i + 1}</span>
        <span class="pipe-body"><span class="pipe-label">{s.label}</span><span class="pipe-verb">{s.verb}</span></span>
      </a>
    </li>
  ))}
</ol>
