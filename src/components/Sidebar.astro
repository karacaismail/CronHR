---
import { CaretDown } from "@phosphor-icons/react";
import CronHRMark from "./CronHRMark";
import { NAV_TREE, resolvePage } from "../data/nav";
import { QUOTES } from "../data/quotes";
import TenantSwitcher from "../islands/TenantSwitcher";
import AccountMenu from "../islands/AccountMenu";

interface Props {
  currentId: string;
}

const { currentId } = Astro.props;
const current = resolvePage(currentId);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<aside class="sidebar" id="kenar-cubugu" aria-label="Kenar çubuğu">
  <a class="brand" href={`${base}/`}>
    <span class="brand-row">
      <span class="brand-mark"><CronHRMark size={20} /></span>
      <span class="brand-name">CronHR</span>
    </span>
    <span class="brand-quote">
      <span class="brand-tag" id="marka-soz">{QUOTES[0].text}</span>
      <span class="brand-attribution" id="marka-atif">{QUOTES[0].author}</span>
    </span>
  </a>

  <TenantSwitcher client:load />

  <nav class="nav" aria-label="Ana menü">
    {NAV_TREE.map((group) => {
      const Icon = group.icon;
      const isActiveGroup = current.group.id === group.id;
      if (!group.children) {
        return (
          <a class="nav-item" href={`${base}${group.href}`} aria-current={isActiveGroup ? "page" : undefined} title={group.label}>
            <Icon size={17} />
            <span class="nav-label">{group.label}</span>
            {group.badge ? <span class="nav-badge" data-tone={group.badgeTone}>{group.badge}</span> : null}
          </a>
        );
      }
      return (
        <details class="nav-group" open={isActiveGroup}>
          <summary class="nav-item nav-summary" data-active={isActiveGroup} title={group.label}>
            <Icon size={17} />
            <span class="nav-label">{group.label}</span>
            {group.badge ? <span class="nav-badge" data-tone={group.badgeTone}>{group.badge}</span> : null}
            <span class="nav-caret"><CaretDown size={12} /></span>
          </summary>
          <div class="nav-children">
            {group.children.map((leaf) => (
              <a class="nav-item nav-leaf" href={`${base}${leaf.href}`} aria-current={current.leaf?.id === leaf.id ? "page" : undefined}>
                <span class="nav-label">{leaf.label}</span>
                {leaf.badge ? <span class="nav-badge" data-tone={leaf.badgeTone}>{leaf.badge}</span> : null}
              </a>
            ))}
          </div>
        </details>
      );
    })}
  </nav>

  <div class="sidebar-foot">
    <AccountMenu client:load base={`${base}/`} name="İsmail Karaca" initials="İK" />
  </div>
</aside>

<script>
  import { QUOTES } from "../data/quotes";
  import { readMotionContext, shouldAnimate } from "../scripts/motion-core";
  import { startQuoteRotation, type QuoteRotationController } from "../scripts/quote";

  let controller: QuoteRotationController | null = null;

  function sync() {
    const textEl = document.getElementById("marka-soz");
    const authorEl = document.getElementById("marka-atif");
    if (!textEl || !authorEl) return;
    const ok = shouldAnimate(readMotionContext());
    if (ok && !controller) {
      controller = startQuoteRotation(textEl, authorEl, QUOTES);
    } else if (!ok && controller) {
      controller.stop();
      controller = null;
    }
  }

  sync();
  window.addEventListener("cronhr:theme", sync);
</script>
