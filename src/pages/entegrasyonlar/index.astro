---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AiBrief from "../../components/AiBrief.astro";
import Kpi from "../../components/Kpi.astro";
import Panel from "../../components/Panel.astro";
import Badge from "../../components/Badge.astro";
import AiHint from "../../islands/AiHint";
import { API_KEYS, INTEGRATIONS, WEBHOOKS } from "../../data/hr2";
import { ArrowsClockwise, Key, Lightning, Plugs, Plus, Sparkle } from "@phosphor-icons/react";

const tone = { "Bağlı": "good", "Hatalı": "critical", "Duraklatıldı": "neutral" } as const;
---

<AdminLayout pageId="entegrasyonlar" description="Bağlı uygulamalar, SSO/SCIM, API anahtarları, webhook'lar ve içe/dışa aktarım. Bağlayıcılar sürümlü adaptörlerdir; hata günlükleri AI tarafından yorumlanır.">
  <Fragment slot="actions">
    <button type="button" class="btn btn-ai" data-ask-ai="Hatalı entegrasyonları göster"><Sparkle size={14} weight="fill" /> Hataları açıkla</button>
    <button type="button" class="btn btn-primary"><Plus size={14} weight="bold" /> Uygulama bağla</button>
  </Fragment>

  <AiBrief
    lead="8 bağlayıcı: 6 bağlı, 1 hatalı, 1 duraklatılmış. <strong>Slack</strong> yetki belirteci 2 gündür geçersiz; leave.approved webhook'u 401 dönüyor. SCIM ile son 24 saatte 2 kullanıcı açıldı, 1 kapatıldı."
    points={[
      { tone: "critical", text: "<strong>Slack</strong>: yeniden yetkilendirme 1 dakika; sonrasında 3 bekleyen izin talebi otomatik içe alınır." },
      { tone: "info", text: "SGK ve GİB adaptörleri sürümlü; şema değişince yalnızca adaptör güncellenir." },
      { tone: "good", text: "PDKS cihaz köprüsü 30 günde 41.900 çağrı, %100 başarı." },
    ]}
    chips={["Son 24 saatteki webhook hatalarını listele", "API anahtarı kullanımını özetle", "Bu sayfayı açıkla"]}
  />

  <div class="grid grid-4">
    <Kpi label="Bağlı uygulama" value="6 / 8" delta="1 hatalı" dir="down" />
    <Kpi label="SSO · SCIM" value="Aktif" delta="Entra ID" dir="up" />
    <Kpi label="API çağrısı (30 gün)" value="61.560" delta="%99,9 başarı" dir="up" />
    <Kpi label="Webhook hatası (24 sa)" value="1" delta="401 · Slack" dir="down" />
  </div>

  <div class="grid grid-main">
    <Panel title="Bağlı uygulamalar" sub="Bağlayıcı, kapsam, son olay" flush>
      <ul>
        {INTEGRATIONS.map((i) => (
          <li class="list-item"><span class="list-icon" data-tone={i.status === "Bağlı" ? "good" : i.status === "Hatalı" ? "critical" : undefined}><Plugs size={16} /></span><span class="list-main"><div class="list-title">{i.name}</div><div class="list-sub">{i.kind} · son {i.last}</div></span><Badge tone={tone[i.status]}>{i.status}</Badge>{i.status === "Hatalı" ? <button type="button" class="icon-btn" aria-label="Yeniden bağla" style="inline-size:28px;block-size:28px"><ArrowsClockwise size={13} /></button> : null}<AiHint client:visible title={`${i.name} · durum`} answer={i.aiNote + "."} actions={i.status === "Hatalı" ? ["Yeniden bağla"] : i.status === "Duraklatıldı" ? ["Yeniden başlat"] : ["Günlüğü aç"]} mode="popover" /></li>
        ))}
      </ul>
    </Panel>
    <div class="stack" style="gap:16px">
      <Panel title="Webhook'lar" sub="Olay → hedef · son yanıt" flush>
        <Fragment slot="icon"><Lightning size={15} /></Fragment>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Olay</th><th>Son</th><th>Yanıt</th></tr></thead>
            <tbody>
              {WEBHOOKS.map((w) => <tr><td><div class="mono">{w.event}</div><div class="small faint" style="max-inline-size:220px;overflow:hidden;text-overflow:ellipsis">{w.url}</div></td><td class="muted">{w.last}</td><td><Badge tone={w.status === "200" ? "good" : w.status === "—" ? "neutral" : "critical"} plain>{w.status}</Badge></td></tr>)}
            </tbody>
          </table>
        </div>
      </Panel>
      <Panel title="API anahtarları" sub="Kapsam ve kullanım" flush>
        <Fragment slot="icon"><Key size={15} /></Fragment>
        <ul>
          {API_KEYS.map((k) => <li class="list-item"><span class="list-main"><div class="list-title">{k.name}</div><div class="list-sub mono">{k.scope}</div></span><span class="small muted" style="text-align:end">{new Intl.NumberFormat("tr-TR").format(k.calls30d)} çağrı<br />son {k.lastUsed}</span></li>)}
        </ul>
      </Panel>
    </div>
  </div>
</AdminLayout>
